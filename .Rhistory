#| label: setup-sesion10
#| message: false
#| warning: false
library(pROC)
library(ggplot2)
# Dataset aSAH: Evaluación del biomarcador s100b para mal pronóstico (outcome)
data(aSAH)
head(aSAH)
#| label: roc-basic
#| message: false
# Objeto ROC (outcome: 'Good' vs 'Poor')
roc_s100b <- roc(
response = aSAH$outcome,
predictor = aSAH$s100b,
levels = c("Good", "Poor"), # Control / Caso
direction = "<"             # "<" indica que valores más altos sugieren el caso ("Poor")
)
# Área bajo la curva (AUC)
auc(roc_s100b)
# Intervalo de confianza al 95% para el AUC (Delong)
ci.auc(roc_s100b)
#| label: fig-roc-plot
#| fig-cap: "Curva ROC para el biomarcador S100b con intervalo de confianza"
plot(
roc_s100b,
main = "Evaluación Diagnóstica: S100b",
col = "#2E9FDF",
lwd = 3,
print.auc = TRUE,
print.auc.x = 0.4,
print.auc.y = 0.2,
auc.polygon = TRUE,
auc.polygon.col = "#2E9FDF22",
grid = TRUE
)
# Añadir IC del 95% dibujado sobre la curva
ci_sp <- ci.se(roc_s100b, specificities = seq(0, 1, 0.1))
plot(ci_sp, type = "shape", col = "#2E9FDF11")
#| label: optimal-cutpoint
# Extracción del punto de corte óptimo por el método de Youden
corte_optimo <- coords(
roc_s100b,
x = "best",
best.method = "youden",
ret = c("threshold", "sensitivity", "specificity", "ppv", "npv")
)
corte_optimo
# Solución de referencia para la corrección de la Tarea 10
library(pROC)
prevecor <- read.csv("_data/prevecor.csv")
# 1. Objeto ROC
roc_prevecor <- roc(
response  = prevecor$evento_cv,
predictor = prevecor$pcr_hs,
levels    = c(0, 1),
direction = "<",
ci        = TRUE
)
# AUC e IC95% (DeLong)
# AUC aprox: ~0.83 - 0.85 según calibración
auc(roc_prevecor)
ci.auc(roc_prevecor)
# 2. Punto de corte óptimo por Youden
corte_youden <- coords(
roc_prevecor,
x           = "best",
best.method = "youden",
ret         = c("threshold", "sensitivity", "specificity", "ppv", "npv", "youden")
)
print(corte_youden)
