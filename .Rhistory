# 1. Simulación de datos clínicos (Cohorte de enfermedad coronaria)
set.seed(2026)
n <- 1000
prevalencia_real <- 0.15 # 15% de pacientes enfermos en la población
estado_real <- factor(rbinom(n, 1, prevalencia_real), levels = c(0, 1), labels = c("Sano", "Enfermo"))
# Biomarcador continuo simulado con mayor media en enfermos
biomarcador <- rnorm(n, mean = 40 + 12 * as.numeric(estado_real), sd = 10)
punto_corte <- 52
resultado_prueba <- factor(ifelse(biomarcador > punto_corte, 1, 0), levels = c(0, 1), labels = c("Negativo", "Positivo"))
# 2. Construcción de la matriz de confusión
matriz_conf <- table(Prueba = resultado_prueba, Real = estado_real)
print("Matriz de Confusión 2x2:")
print(matriz_conf)
# 3. Cálculo manual directo de métricas clave (Evita errores de paquetes externos)
VP <- matriz_conf["Positivo", "Enfermo"]
FP <- matriz_conf["Positivo", "Sano"]
FN <- matriz_conf["Negativo", "Enfermo"]
VN <- matriz_conf["Negativo", "Sano"]
sensibilidad <- VP / (VP + FN)
especificidad <- VN / (VN + FP)
vpp <- VP / (VP + FP)
vpn <- VN / (VN + FN)
cat(sprintf("\nSensibilidad: %.3f\n", sensibilidad))
cat(sprintf("Especificidad: %.3f\n", especificidad))
cat(sprintf("Valor Predictivo Positivo (VPP): %.3f\n", vpp))
cat(sprintf("Valor Predictivo Negativo (VPN): %.3f\n", vpn))
