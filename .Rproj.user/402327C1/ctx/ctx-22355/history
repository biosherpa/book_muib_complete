# ==============================================================================
# Generación del archivo prevecor.csv (Dataset continuo para ROC)
# ==============================================================================
set.seed(2026) # Semilla para reproducibilidad
n <- 400       # Tamaño muestral
# 1. Generar variables sociodemográficas y de riesgo cardiovascular
prevecor_data <- data.frame(
id = 1:n,
edad = round(rnorm(n, mean = 62, sd = 9)),
sexo = sample(c("Hombre", "Mujer"), n, replace = TRUE, prob = c(0.60, 0.40)),
colesterol_mgdl = round(rnorm(n, mean = 220, sd = 35)),
pas_mmhg = round(rnorm(n, mean = 138, sd = 16)),
# Gold Standard: Prevalencia del 30%
evento_cv = sample(c(1, 0), n, replace = TRUE, prob = c(0.30, 0.70))
)
# 2. Generar el biomarcador hs-PCR como variable continua (mg/L)
# Usamos una distribución Log-Normal dependiente de evento_cv:
# - Sanos (0): mediana ≈ 1.5 mg/L
# - Enfermos (1): mediana ≈ 3.5 mg/L
log_mu <- log(1.5) + log(2.3) * prevecor_data$evento_cv
prevecor_data$pcr_hs <- round(rlnorm(n, meanlog = log_mu, sdlog = 0.45), 2)
# 3. Guardar como archivo CSV en _data y en raíz para mayor comodidad
dir.create("_data", showWarnings = FALSE)
write.csv(prevecor_data, "_data/prevecor.csv", row.names = FALSE)
write.csv(prevecor_data, "prevecor.csv", row.names = FALSE)
cat("El archivo 'prevecor.csv' se ha creado correctamente con pcr_hs continua.\n")
# 1. Carga e inspección de datos ----------------------------------------------
prevecor <- read.csv("prevecor.csv", stringsAsFactors = TRUE)
prevecor$evento_fac <- factor(prevecor$evento_cv, levels = c(1, 0), labels = c("Enfermo", "Sano"))
# Test Dicotomizado: Forzamos Nivel 1 = "Positivo" para que ocupe la Fila 1 en table()
prevecor$test_pcr <- factor(
cut(prevecor$pcr_hs, breaks = c(-Inf, 3.0, Inf), labels = c("Negativo", "Positivo")),
levels = c("Positivo", "Negativo")
)
matriz_2x2 <- table(prevecor$test_pcr, prevecor$evento_fac)
cat("\n--- Tabla de Contingencia 2x2 Correctamente Orientada ---\n")
print(matriz_2x2)
# 3. Cálculo de Índices Diagnósticos con epiR -------------------------------
res_diag <- epi.tests(matriz_2x2, conf.level = 0.95)
# 4. Tabulación de resultados ------------------------------------------------
metricas_clave <- c("se", "sp", "pv.pos", "pv.neg", "lr.pos", "lr.neg")
etiquetas <- c(
"se"     = "Sensibilidad (s)",
"sp"     = "Especificidad (e)",
"pv.pos" = "Valor Predictivo Positivo (VPP)",
"pv.neg" = "Valor Predictivo Negativo (VPN)",
"lr.pos" = "Razón de Verosimilitud (+)",
"lr.neg" = "Razón de Verosimilitud (-)"
)
tabla_final <- res_diag$detail %>%
filter(statistic %in% metricas_clave) %>%
mutate(
Indicador = etiquetas[statistic],
`Estimación Puntual` = round(est, 3),
`IC 95%` = sprintf("[%.3f – %.3f]", lower, upper)
) %>%
select(Indicador, `Estimación Puntual`, `IC 95%`)
kable(tabla_final, align = c("l", "c", "c"), caption = "Resultados de la Validación Diagnóstica")
