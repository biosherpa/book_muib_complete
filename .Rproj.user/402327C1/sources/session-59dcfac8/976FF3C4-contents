#### 4. INTERACCIONES             ####
#--------------------------------------#

# Pregunta:
#
# ¿Es el efecto del tabaquismo igual
# para mujeres jóvenes y mayores?


#### 4.1 Ajuste de un modelo con interacción ####

modelo_age <- lm(
  bwt ~ smoke + age,
  data = birthwt
)


modelo_interaccion <- lm(
  bwt ~ smoke * age,
  data = birthwt
)

summary(modelo_age)
summary(modelo_interaccion)

#### Reflexión ####
# Observa el cambio en el coeficiente de la variable "smoke" y "age"
# El pvalor también cambia. ¿Qué significa esto?

#### 4.2 Visualización de la interacción ####

grafico_interaccion <- ggplot(
  birthwt,
  aes(
    x = age,
    y = bwt,
    colour = smoke
  )
) +
  geom_point(
    alpha = 0.5
  ) +
  geom_smooth(
    method = "lm",
    se = FALSE
  ) +
  labs(
    title = "Interacción entre edad y tabaquismo",
    x = "Edad materna",
    y = "Peso al nacer (g)"
  )

print(grafico_interaccion)

