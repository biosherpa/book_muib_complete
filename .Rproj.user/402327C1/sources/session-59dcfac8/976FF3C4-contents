#### 3. COMBINAR VARIABLES        ####
#### CONTINUAS Y FACTORES         ####
#--------------------------------------#

# Pregunta biomédica:
#
# ¿Cambia el efecto del tabaquismo
# cuando tenemos en cuenta otras
# características maternas?
#
# Por ejemplo, la edad y el peso de la madre.


#### 2.1 Modelo simple ####

# En la sesión anterior ajustamos:
modelo_simple <- lm(
  bwt ~ smoke,
  data = birthwt
)

summary(modelo_simple)

# Recordatorio:
#
# β1 representa la diferencia media
# de peso al nacer entre fumadoras
# y no fumadoras.


#### 2.2 Modelo ajustado ####


#Fumadora: 0 = No, 1 = Sí
birthwt$smoke <- factor(
  birthwt$smoke,
  levels = c(0,1),
  labels = c(
    "No fumadora",
    "Fumadora"
  )
)

#Ajusto modelo

modelo_ajustado <- lm(
  bwt ~ age + lwt+smoke,
  data = birthwt
)

summary(modelo_ajustado)

#### Comparación ####

coef(modelo_simple)

coef(modelo_ajustado)

print(tabla_confusion)

#### Reflexión ####

# ¿Ha cambiado la estimación
# del efecto del tabaquismo?
#
# ¿Qué nos indica esto sobre la
# presencia de confusión?
#
# ¿Por qué es importante ajustar
# por otras variables?


#Raza: 1 = Blanca, 2 = Negra, 3 = Otra
birthwt$race <- factor(
  birthwt$race,
  levels = c(1,2,3),
  labels = c(
    "Blanca",
    "Negra",
    "Otra"
  )
)

modelo_race <- lm(
  bwt ~ smoke + race,
  data = birthwt
)

summary(modelo_race)


coef(modelo_simple)[2]
coef(modelo_race)[2]

tabla_confusion <- data.frame(
  Modelo = c(
    "Simple",
    "Ajustado"
  ),
  Beta_smoke = c(
    coef(modelo_simple)[2],
    coef(modelo_race)[2]
  )
)

print(tabla_confusion)
# El modelo simple estima una reducción de 284 g.
# El modelo ajustado estima una reducción de 429 g.

# Conclusión: La estimación del efecto de smoke es sensible a cómo se especifica el modelo

