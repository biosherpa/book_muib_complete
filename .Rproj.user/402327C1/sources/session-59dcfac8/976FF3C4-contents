#### 1. CONFIGURACIÓN INICIAL         ####
#--------------------------------------#

library(ggplot2)

theme_set(theme_classic(base_size = 12))

# Comprobar directorio de trabajo

getwd()


#### CARGAR DATOS ####


birthwt <- read.csv(
  "data/birthwt.csv"
)

#Transformar lwt y bwt a kg
birthwt$lwt <- birthwt$lwt * 0.453592 # 1 lb = 0.453592 kg
birthwt$bwt <- birthwt$bwt / 1000 # 1 kg  = 1000 gr


#--------------------------------------#
#### 2. FACTORES CON MÁS DE       ####
#### DOS NIVELES                 ####
#--------------------------------------#

#### Visualización

grafico_race <- ggplot(
  birthwt,
  aes(
    x = race,
    y = bwt,
    fill = race
  )
) +
  geom_boxplot() +
  labs(
    title = "Peso al nacer según grupo racial",
    x = "Grupo racial",
    y = "Peso al nacer (g)"
  )

print(grafico_race)

#### Modelo lineal

modelo_race <- lm(
  bwt ~ race,
  data = birthwt
)

summary(modelo_race)

#Pregunta: ¿Hay diferencias entre "Negra" y "Otra"?


#### 2.1 Análisis de la varianza ####

#ANOVA es una herramienta para evaluar el efecto global
#de un factor dentro de un modelo lineal.
anova(modelo_race)

#### Reflexión

# ANOVA significa:
#
# Analysis Of Variance
#
# Análisis de la varianza.
#
# ¿Qué está comparando ANOVA?
#
# ¿Existen diferencias globales
# entre los tres grupos?
#
# ¿Entre qué grupos se encuentran estas diferencias?
#

#### 2.2 Análisis post-hoc ####

# Si el ANOVA indica diferencias globales,
# podemos realizar comparaciones post-hoc


test.pairwise <- pairwise.t.test(
  birthwt$bwt,
  birthwt$race,
  p.adjust.method = "bonferroni"
)


print(test.pairwise)

#Pregunta: ¿ Ahora podemos responder a la pregunta de 
# si hay diferencias entre "Negra" y "Otra"?


